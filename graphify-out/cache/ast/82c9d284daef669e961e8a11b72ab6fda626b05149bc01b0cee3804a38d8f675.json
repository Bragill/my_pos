);\r\n                    return (\r\n                      <>\r\n                        <div className=\"space-y-2\">\r\n                          {paged.map(order => {\r\n                            const isOpen = expandedOrderId === order.id;\r\n                            const detail = expandedOrderDetail[order.id];\r\n                            return (\r\n                              <div key={order.id} className=\"rounded-2xl border border-gray-100 overflow-hidden transition-all\">\r\n                                {/* Row header \u2014 click to expand */}\r\n                                <div className=\"flex items-center justify-between px-4 py-3 cursor-pointer hover:bg-purple-50 transition-colors\"\r\n                                  onClick={() => toggleMonthOrder(order)}>\r\n                                  <div>\r\n                                    <div className=\"flex items-center gap-2\">\r\n                                      <span className=\"text-xs font-mono font-semibold\" style={{ color:'#95008A' }}>{order.order_no}</span>\r\n                                      <span className={`text-xs px-2 py-0.5 rounded-full font-medium ${\r\n                                        order.status === 'completed' ? 'bg-green-100 text-green-700' :\r\n                                        order.status === 'outstanding' ? 'bg-amber-100 text-amber-700' :\r\n                                        'bg-gray-100 text-gray-500'}`}>\r\n                                        {order.status === 'completed' ? '\u0e0a\u0e33\u0e23\u0e30\u0e41\u0e25\u0e49\u0e27' : order.status === 'outstanding' ? '\u0e04\u0e49\u0e32\u0e07\u0e0a\u0e33\u0e23\u0e30' : order.status}\r\n                                      </span>\r\n                                    </div>\r\n                                    <p className=\"text-xs text-gray-400 mt-0.5\">\r\n                                      {order.created_at?.slice(0,16)} \u00b7 {order.cashier_name}\r\n                                      {order.debtor_name && ` \u00b7 ${order.debtor_name}`}\r\n                                    </p>\r\n                                    <p className=\"text-xs text-gray-300 mt-0.5\">{getPayLabel(order.payment_method, order)}</p>\r\n                                  </div>\r\n                                  <div className=\"flex items-center gap-2 flex-shrink-0\">\r\n                                    <p className=\"font-bold text-gray-800\">{formatCurrency(order.total_amount)}</p>\r\n                                    <span className=\"text-gray-400 text-sm transition-transform duration-200\"\r\n                                      style={{ display:'inline-block', transform: isOpen ? 'rotate(90deg)' : 'rotate(0deg)' }}>\u203a</span>\r\n                                  </div>\r\n                                </div>\r\n\r\n                                {/* Expanded detail */}\r\n                                {isOpen && (\r\n                                  <div className=\"border-t border-gray-100 bg-gray-50 px-4 py-3\">\r\n                                    {!detail ? (\r\n                                      <p className=\"text-xs text-gray-400 text-center py-2\">\u23f3 \u0e01\u0e33\u0e25\u0e31\u0e07\u0e42\u0e2b\u0e25\u0e14...</p>\r\n                                    ) : (\r\n                                      <>\r\n                                        <p className=\"text-xs font-semibold text-gray-500 mb-2\">\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32</p>\r\n                                        <div className=\"space-y-1.5\">\r\n                                          {detail.items?.map(item => (\r\n                                            <div key={item.id} className=\"flex justify-between items-center text-xs\">\r\n                                              <span className=\"text-gray-700\">{item.product_name}\r\n                                                <span className=\"text-gray-400 ml-1\">\u00d7 {item.quantity}</span>\r\n                                              </span>\r\n                                              <span className=\"font-semibold text-gray-700\">{formatCurrency(item.total_price)}</span>\r\n                                            </div>\r\n                                          ))}\r\n                                        </div>\r\n                                        <div className=\"mt-2.5 pt-2 border-t border-gray-200 space-y-1\">\r\n                                          <div className=\"flex justify-between text-xs text-gray-500\">\r\n                                            <span>\u0e22\u0e2d\u0e14\u0e23\u0e27\u0e21</span><span>{formatCurrency(detail.sub_total)}</span>\r\n                                          </div>\r\n                                          {detail.discount > 0 && (\r\n                                            <div className=\"flex justify-between text-xs text-red-500\">\r\n                                              <span>\u0e2a\u0e48\u0e27\u0e19\u0e25\u0e14</span><span>-{formatCurrency(detail.discount)}</span>\r\n                                            </div>\r\n                                          )}\r\n                                          {detail.tax > 0 && (\r\n                                            <div className=\"flex justify-between text-xs text-gray-500\">\r\n                                              <span>VAT</span><span>{formatCurrency(detail.tax)}</span>\r\n                                            </div>\r\n                                          )}\r\n                                          <div className=\"flex justify-between text-sm font-bold text-gray-800 pt-1\">\r\n                                            <span>\u0e23\u0e27\u0e21\u0e17\u0e31\u0e49\u0e07\u0e2a\u0e34\u0e49\u0e19</span><span style={{color:'#3300FC'}}>{formatCurrency(detail.total_amount)}</span>\r\n                                          </div>\r\n                                        </div>\r\n                                        {detail.remark && (\r\n                                          <p className=\"text-xs text-gray-400 mt-2\">\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38: {detail.remark}</p>\r\n                                        )}\r\n                                      </>\r\n                                    )}\r\n                                  </div>\r\n                                )}\r\n                              </div>\r\n                            );\r\n                          })}\r\n                        </div>\r\n\r\n                        {/* Pagination */}\r\n                        {totalPages > 1 && (\r\n                          <div className=\"flex items-center justify-between mt-4 pt-3 border-t border-gray-100\">\r\n                            <button onClick={() => setMonthPage(p => Math.max(1, p-1))} disabled={monthPage === 1}\r\n                              className=\"px-3 py-1.5 rounded-xl text-sm border border-gray-200 text-gray-600 hover:bg-gray-50 disabled:opacity-40 transition-all\">\r\n                              \u2190 \u0e01\u0e48\u0e2d\u0e19\u0e2b\u0e19\u0e49\u0e32\r\n                            </button>\r\n                            <span className=\"text-xs text-gray-400\">{monthPage} / {totalPages}</span>\r\n                            <button onClick={() => setMonthPage(p => Math.min(totalPages, p+1))} disabled={monthPage === totalPages}\r\n                              className=\"px-3 py-1.5 rounded-xl text-sm border border-gray-200 text-gray-600 hover:bg-gray-50 disabled:opacity-40 transition-all\">\r\n                              \u0e16\u0e31\u0e14\u0e44\u0e1b \u2192\r\n                            </button>\r\n                          </div>\r\n                        )}\r\n                      </>\r\n                    );\r\n                  })", "is_member_call": false, "source_file": "D:\\Project\\POS\\POS_Pro