const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

const publicDir = path.join(__dirname, 'public');
const certPath = path.join(publicDir, 'rootCA.crt');
const keyPath = path.join(publicDir, 'rootCA.key');

// Create public directory if it doesn't exist
if (!fs.existsSync(publicDir)) {
  fs.mkdirSync(publicDir, { recursive: true });
}

// Check if certificates already exist
if (fs.existsSync(certPath) && fs.existsSync(keyPath)) {
  console.log('SSL certificates already exist.');
  process.exit(0);
}

// Generate self-signed certificate
const command = `openssl req -x509 -newkey rsa:2048 -keyout "${keyPath}" -out "${certPath}" -days 365 -nodes -subj "/CN=localhost"`;

try {
  execSync(command, { stdio: 'inherit' });
  console.log('SSL certificates generated successfully!');
} catch (error) {
  console.error('Error generating certificates:', error.message);
  console.log('You may need to install OpenSSL or generate certificates manually.');
}
