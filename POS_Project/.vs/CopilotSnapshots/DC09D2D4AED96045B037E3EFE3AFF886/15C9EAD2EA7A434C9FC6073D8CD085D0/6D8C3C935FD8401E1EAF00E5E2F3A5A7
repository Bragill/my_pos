import { useEffect, useRef, useState, useCallback } from 'react';
import ScanIcon from './ScanIcon';

export default function BarcodeScanner({ onDetected, onClose }) {
  const videoRef = useRef(null);
  const streamRef = useRef(null);
  const readerRef = useRef(null);
  const fileInputRef = useRef(null);
  const [error, setError] = useState(null);
  const [scanning, setScanning] = useState(false);
  const [mode, setMode] = useState('camera');
  const [processing, setProcessing] = useState(false);

  const stopCamera = useCallback(() => {
    if (readerRef.current) {
      try { readerRef.current.reset(); } catch {}
      readerRef.current = null;
    }
    if (streamRef.current) {
      streamRef.current.getTracks().forEach(t => t.stop());
      streamRef.current = null;
    }
    setScanning(false);
  }, []);

  const handleClose = useCallback(() => { stopCamera(); onClose(); }, [stopCamera, onClose]);

  const startCamera = useCallback(async () => {
    stopCamera();
    setError(null);
    const ZXing = window.ZXing;
    if (!ZXing) {
      setError('ไม่พบ ZXing library กรุณาตรวจสอบการเชื่อมต่ออินเทอร์เน็ต');
      return;
    }
    try {
      const hints = new Map();
      hints.set(ZXing.DecodeHintType.TRY_HARDER, true);
      const reader = new ZXing.BrowserMultiFormatReader(hints);
      readerRef.current = reader;

      // Try to get back camera deviceId via enumerate (needs prior permission)
      let deviceId = null;
      try {
        const devices = await navigator.mediaDevices.enumerateDevices();
        const cams = devices.filter(d => d.kind === 'videoinput');
        const back = cams.find(d => /back|rear|environment/i.test(d.label));
        deviceId = back?.deviceId || null;
      } catch {}

      // If no deviceId found, use facingMode constraint via getUserMedia first
      if (!deviceId) {
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' } } });
          streamRef.current = stream;
          const track = stream.getVideoTracks()[0];
          deviceId = track.getSettings().deviceId || null;
          stream.getTracks().forEach(t => t.stop());
          streamRef.current = null;
        } catch {}
      }

      setScanning(true);
      await reader.decodeFromVideoDevice(deviceId, videoRef.current, (result) => {
        if (result) { stopCamera(); onDetected(result.getText()); }
      });
    } catch (err) {
      setError('ไม่สามารถเปิดกล้องได้: ' + (err.message || String(err)));
      setScanning(false);
    }
  }, [stopCamera, onDetected]);

  useEffect(() => {
    if (mode === 'camera') startCamera();
    return () => stopCamera();
  }, [mode]);

  const handleFileChange = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setProcessing(true);
    setError(null);
    try {
      const ZXing = window.ZXing;
      const hints = new Map();
      hints.set(ZXing.DecodeHintType.TRY_HARDER, true);
      const reader = new ZXing.BrowserMultiFormatReader(hints);
      const url = URL.createObjectURL(file);
      const result = await reader.decodeFromImageUrl(url);
      URL.revokeObjectURL(url);
      onDetected(result.getText());
    } catch {
      setError('ไม่พบบาร์โค้ดในภาพ กรุณาลองใหม่');
    } finally {
      setProcessing(false);
      if (fileInputRef.current) fileInputRef.current.value = '';
    }
  };

  return (
    <div className="fixed inset-0 bg-black/90 flex flex-col items-center justify-center z-[60] p-4">
      <div className="w-full max-w-sm">
        <div className="flex items-center justify-between mb-4">
          <div className="flex items-center gap-2">
            <ScanIcon size={22} color="white" strokeWidth={2} />
            <h3 className="text-white font-bold text-lg">สแกนบาร์โค้ด</h3>
          </div>
          <button onClick={handleClose}
            className="w-9 h-9 rounded-full bg-white/20 hover:bg-white/30 text-white flex items-center justify-center">✕</button>
        </div>

        <div className="flex rounded-xl overflow-hidden border border-white/20 mb-4">
          {[{ key: 'camera', label: '📷 กล้อง' }, { key: 'file', label: '🖼️ อัปโหลดภาพ' }].map(m => (
            <button key={m.key} onClick={() => setMode(m.key)}
              className="flex-1 py-2 text-sm font-medium transition-colors"
              style={mode === m.key ? { background: 'white', color: '#1f2937' } : { background: 'transparent', color: 'rgba(255,255,255,0.7)' }}>
              {m.label}
            </button>
          ))}
        </div>

        {mode === 'camera' ? (
          error ? (
            <div className="bg-white rounded-2xl p-6 text-center space-y-3">
              <p className="text-3xl">❌</p>
              <p className="font-semibold text-red-700 text-sm">{error}</p>
              <button onClick={startCamera} className="btn-primary w-full mt-2">ลองใหม่</button>
              <button onClick={() => setMode('file')} className="w-full py-2 text-sm text-gray-500 underline">ใช้การอัปโหลดภาพแทน</button>
            </div>
          ) : (
            <>
              <div className="relative rounded-2xl overflow-hidden bg-black aspect-square w-full">
                <video ref={videoRef} autoPlay playsInline muted className="w-full h-full object-cover" />
                <div className="absolute inset-0 flex items-center justify-center">
                  <div className="w-56 h-40 relative">
                    {['top-0 left-0 border-t-4 border-l-4 rounded-tl-xl','top-0 right-0 border-t-4 border-r-4 rounded-tr-xl','bottom-0 left-0 border-b-4 border-l-4 rounded-bl-xl','bottom-0 right-0 border-b-4 border-r-4 rounded-br-xl'].map((cls, i) => (
                      <div key={i} className={`absolute w-8 h-8 border-white ${cls}`} />
                    ))}
                    <div className="absolute inset-x-2 h-0.5 bg-green-400/80 animate-scan top-1/2" />
                  </div>
                </div>
                <div className="absolute bottom-3 left-0 right-0 text-center">
                  <span className="text-white/80 text-xs bg-black/40 px-3 py-1 rounded-full">
                    {scanning ? '🔍 กำลังสแกน...' : '⏳ เปิดกล้อง...'}
                  </span>
                </div>
              </div>
              <p className="text-white/60 text-xs text-center mt-3">วางบาร์โค้ดในกรอบเพื่อสแกน — รองรับ EAN-13, Code-128, QR Code</p>
            </>
          )
        ) : (
          <div className="bg-white rounded-2xl p-6 text-center space-y-4">
            <p className="text-4xl">📸</p>
            <p className="text-gray-700 font-medium">ถ่ายภาพหรือเลือกรูปบาร์โค้ด</p>
            <input ref={fileInputRef} type="file" accept="image/*" capture="environment"
              onChange={handleFileChange} className="hidden" id="barcode-file-input" />
            <label htmlFor="barcode-file-input"
              className="block w-full py-3 rounded-xl text-white font-semibold cursor-pointer text-sm"
              style={{ backgroundImage: 'linear-gradient(to left,#3300FC,#95008A,#EB0000)' }}>
              {processing ? '⏳ กำลังอ่าน...' : '📷 เปิดกล้อง / เลือกภาพ'}
            </label>
            {error && <p className="text-red-600 text-sm">{error}</p>}
            <p className="text-gray-400 text-xs">รองรับทุกบราวเซอร์ — Chrome, Safari, Firefox</p>
          </div>
        )}
      </div>
    </div>
  );
}
