import { Outlet, NavLink, useNavigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';

const navItems = [
  { path: '/pos', label: 'หน้าขาย', icon: '🛒', roles: ['admin', 'manager', 'cashier'] },
  { path: '/dashboard', label: 'แดชบอร์ด', icon: '📊', roles: ['admin', 'manager'] },
  { path: '/products', label: 'สินค้า', icon: '📦', roles: ['admin', 'manager'] },
  { path: '/inventory', label: 'สต๊อก', icon: '🏪', roles: ['admin', 'manager'] },
  { path: '/customers', label: 'ลูกค้า', icon: '👥', roles: ['admin', 'manager', 'cashier'] },
  { path: '/settings', label: 'ตั้งค่า', icon: '⚙️', roles: ['admin'] },
];

export default function Layout() {
  const { user, logout } = useAuth();
  const navigate = useNavigate();

  const handleLogout = () => { logout(); navigate('/login'); };
  const visibleNav = navItems.filter((item) => item.roles.includes(user?.role));

  return (
    <div className="min-h-screen flex flex-col" style={{ background: 'linear-gradient(160deg,#f8f7ff 0%,#ede9fe 100%)' }}>
      {/* Navbar */}
      <nav className="shadow-md px-3 py-2 flex items-center justify-between sticky top-0 z-40"
        style={{ background: 'linear-gradient(135deg,#4f46e5 0%,#7c3aed 100%)' }}>
        {/* Logo */}
        <div className="flex items-center gap-2 mr-3 flex-shrink-0">
          <span className="text-white font-bold text-lg hidden sm:block tracking-wide">🛒 POS</span>
        </div>

        {/* Nav Links */}
        <div className="flex items-center gap-1 overflow-x-auto flex-1 scrollbar-hide">
          {visibleNav.map((item) => (
            <NavLink
              key={item.path}
              to={item.path}
              className={({ isActive }) =>
                `flex flex-col sm:flex-row items-center justify-center px-2 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all whitespace-nowrap min-w-[44px] gap-0.5 sm:gap-1 ` +
                (isActive
                  ? 'bg-white/25 text-white shadow-inner backdrop-blur-sm'
                  : 'text-indigo-100 hover:bg-white/15 hover:text-white')
              }
            >
              <span className="text-base sm:text-sm">{item.icon}</span>
              <span className="hidden sm:inline">{item.label}</span>
            </NavLink>
          ))}
        </div>

        {/* User + Logout */}
        <div className="flex items-center gap-2 ml-2 flex-shrink-0">
          <div className="hidden md:flex flex-col items-end">
            <span className="text-xs text-white font-semibold leading-tight">{user?.fullName}</span>
            <span className="text-xs text-indigo-200 capitalize leading-tight">{user?.role}</span>
          </div>
          <button
            onClick={handleLogout}
            className="text-xs text-white bg-white/20 hover:bg-white/30 active:bg-white/40 px-3 py-2 rounded-xl transition-all whitespace-nowrap backdrop-blur-sm border border-white/20"
          >
            ออกจากระบบ
          </button>
        </div>
      </nav>

      <main className="flex-1 overflow-hidden">
        <Outlet />
      </main>
    </div>
  );
}
