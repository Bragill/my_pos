import { useState, useEffect } from 'react';
import { formatCurrency, formatShortDate } from '../utils/format';
import api from '../services/api';

export default function DashboardPage() {
  const [dashboard, setDashboard] = useState(null);
  const [dailySales, setDailySales] = useState([]);
  const [topProducts, setTopProducts] = useState([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    loadDashboard();
  }, []);

  const loadDashboard = async () => {
    try {
      const [dashRes, salesRes, topRes] = await Promise.all([
        api.get('/reports/dashboard'),
        api.get('/reports/daily-sales', { params: { days: 7 } }),
        api.get('/reports/top-products', { params: { limit: 5 } }),
      ]);
      setDashboard(dashRes.data.data);
      setDailySales(salesRes.data.data);
      setTopProducts(topRes.data.data);
    } catch (err) {
      console.error(err);
    } finally {
      setLoading(false);
    }
  };

  if (loading) {
    return <div className="flex items-center justify-center h-64 text-gray-400">กำลังโหลด...</div>;
  }

  return (
    <div className="p-6 overflow-y-auto h-[calc(100vh-56px)]">
      <h1 className="text-2xl font-bold text-gray-800 mb-6">📊 แดชบอร์ด</h1>

      {/* Summary Cards */}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <SummaryCard title="ยอดขายวันนี้" value={formatCurrency(dashboard?.today_sales || 0)} color="blue" />
        <SummaryCard title="จำนวนบิลวันนี้" value={dashboard?.today_orders || 0} color="green" />
        <SummaryCard title="ยอดขายเดือนนี้" value={formatCurrency(dashboard?.month_sales || 0)} color="purple" />
        <SummaryCard title="สินค้าใกล้หมด" value={dashboard?.low_stock_count || 0} color="red" />
      </div>

      <div className="grid md:grid-cols-2 gap-6">
        {/* ยอดขายรายวัน */}
        <div className="card">
          <h3 className="font-semibold text-gray-800 mb-4">📈 ยอดขาย 7 วันล่าสุด</h3>
          <div className="space-y-2">
            {dailySales.map((day) => (
              <div key={day.date} className="flex justify-between items-center py-2 border-b border-gray-50">
                <span className="text-sm text-gray-600">{formatShortDate(day.date)}</span>
                <div className="text-right">
                  <span className="text-sm font-semibold">{formatCurrency(day.total_sales)}</span>
                  <span className="text-xs text-gray-400 ml-2">({day.total_orders} บิล)</span>
                </div>
              </div>
            ))}
            {dailySales.length === 0 && <p className="text-gray-400 text-sm">ยังไม่มีข้อมูล</p>}
          </div>
        </div>

        {/* สินค้าขายดี */}
        <div className="card">
          <h3 className="font-semibold text-gray-800 mb-4">🏆 สินค้าขายดี Top 5</h3>
          <div className="space-y-2">
            {topProducts.map((product, idx) => (
              <div key={product.id} className="flex justify-between items-center py-2 border-b border-gray-50">
                <div className="flex items-center gap-2">
                  <span className="w-6 h-6 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center text-xs font-bold">
                    {idx + 1}
                  </span>
                  <span className="text-sm font-medium">{product.name}</span>
                </div>
                <div className="text-right">
                  <span className="text-sm font-semibold">{product.total_quantity} ชิ้น</span>
                  <p className="text-xs text-gray-400">{formatCurrency(product.total_revenue)}</p>
                </div>
              </div>
            ))}
            {topProducts.length === 0 && <p className="text-gray-400 text-sm">ยังไม่มีข้อมูล</p>}
          </div>
        </div>
      </div>
    </div>
  );
}

function SummaryCard({ title, value, color }) {
  const colors = {
    blue: 'bg-blue-50 text-blue-700 border-blue-200',
    green: 'bg-green-50 text-green-700 border-green-200',
    purple: 'bg-purple-50 text-purple-700 border-purple-200',
    red: 'bg-red-50 text-red-700 border-red-200',
  };

  return (
    <div className={`rounded-xl border p-4 ${colors[color]}`}>
      <p className="text-sm opacity-80">{title}</p>
      <p className="text-2xl font-bold mt-1">{value}</p>
    </div>
  );
}
