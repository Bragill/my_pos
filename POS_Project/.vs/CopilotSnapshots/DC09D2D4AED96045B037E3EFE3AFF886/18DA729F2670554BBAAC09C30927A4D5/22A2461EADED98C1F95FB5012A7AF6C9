@tailwind base;
@tailwind components;
@tailwind utilities;

body {
  font-family: 'Prompt', 'Noto Sans Thai', sans-serif;
  background: linear-gradient(160deg, #f8f7ff 0%, #ede9fe 100%);
  min-height: 100vh;
}

@layer components {
  /* ── Buttons ── */
  .btn-primary {
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    @apply text-white font-semibold py-3 px-6 rounded-xl
           hover:opacity-90 active:scale-95
           transition-all min-h-touch min-w-touch flex items-center justify-center
           shadow-md;
  }

  .btn-success {
    background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
    @apply text-white font-bold py-4 px-8 rounded-2xl
           hover:opacity-90 active:scale-95
           transition-all min-h-touch text-lg flex items-center justify-center
           shadow-md;
  }

  .btn-danger {
    background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
    @apply text-white font-semibold py-3 px-6 rounded-xl
           hover:opacity-90 active:scale-95
           transition-all min-h-touch min-w-touch flex items-center justify-center;
  }

  .btn-ghost {
    @apply bg-white/70 hover:bg-white border border-indigo-100 text-indigo-700
           font-medium py-3 px-4 rounded-xl backdrop-blur-sm
           transition-all min-h-touch min-w-touch flex items-center justify-center;
  }

  /* ── Card ── */
  .card {
    @apply bg-white/80 backdrop-blur-sm rounded-2xl border border-white/60 p-5;
    box-shadow: 0 2px 16px 0 rgba(99,102,241,0.08);
  }

  /* ── Input ── */
  .input-field {
    @apply w-full bg-white/80 border border-indigo-100 rounded-xl px-4 py-3 text-base
           focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent
           placeholder-gray-400 transition-all backdrop-blur-sm;
  }

  /* ── Product Card ── */
  .product-grid-item {
    @apply bg-white/80 backdrop-blur-sm rounded-2xl border border-white/60
           p-3 cursor-pointer
           hover:-translate-y-0.5 hover:border-indigo-200
           transition-all flex flex-col items-center justify-center min-h-[100px]
           active:scale-95;
    box-shadow: 0 2px 16px 0 rgba(99,102,241,0.08);
  }
  .product-grid-item:hover {
    box-shadow: 0 4px 24px 0 rgba(99,102,241,0.18);
  }

  /* ── Category Tabs ── */
  .category-tab {
    @apply px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap
           min-h-touch flex items-center justify-center cursor-pointer transition-all;
  }

  .category-tab-active {
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    @apply text-white shadow-md;
  }

  .category-tab-inactive {
    @apply bg-white/70 text-gray-600 hover:bg-white border border-indigo-100;
  }
}
