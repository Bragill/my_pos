@tailwind base;
@tailwind components;
@tailwind utilities;

body {
  font-family: 'Prompt', 'Noto Sans Thai', sans-serif;
  background: linear-gradient(160deg, #f8f7ff 0%, #ede9fe 100%);
  min-height: 100vh;
}

@layer components {
  /* ── Buttons ── */
  .btn-primary {
    @apply bg-grad-primary text-white font-semibold py-3 px-6 rounded-xl
           shadow-glow-sm hover:opacity-90 active:scale-95
           transition-all min-h-touch min-w-touch flex items-center justify-center;
  }

  .btn-success {
    @apply bg-grad-success text-white font-bold py-4 px-8 rounded-2xl
           shadow-glow-sm hover:opacity-90 active:scale-95
           transition-all min-h-touch text-lg flex items-center justify-center;
  }

  .btn-danger {
    @apply bg-grad-danger text-white font-semibold py-3 px-6 rounded-xl
           hover:opacity-90 active:scale-95
           transition-all min-h-touch min-w-touch flex items-center justify-center;
  }

  .btn-ghost {
    @apply bg-white/70 hover:bg-white border border-primary-100 text-primary-700
           font-medium py-3 px-4 rounded-xl backdrop-blur-sm
           transition-all min-h-touch min-w-touch flex items-center justify-center;
  }

  /* ── Card ── */
  .card {
    @apply bg-white/80 backdrop-blur-sm rounded-2xl shadow-card
           border border-white/60 p-5;
  }

  /* ── Input ── */
  .input-field {
    @apply w-full bg-white/80 border border-primary-100 rounded-xl px-4 py-3 text-base
           focus:outline-none focus:ring-2 focus:ring-primary-400 focus:border-transparent
           placeholder-gray-400 transition-all backdrop-blur-sm;
  }

  /* ── Product Card ── */
  .product-grid-item {
    @apply bg-white/80 backdrop-blur-sm rounded-2xl border border-white/60
           shadow-card p-3 cursor-pointer
           hover:shadow-glow hover:border-primary-200 hover:-translate-y-0.5
           transition-all flex flex-col items-center justify-center min-h-[100px]
           active:scale-95;
  }

  /* ── Category Tabs ── */
  .category-tab {
    @apply px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap
           min-h-touch flex items-center justify-center cursor-pointer transition-all;
  }

  .category-tab-active {
    @apply bg-grad-primary text-white shadow-glow-sm;
  }

  .category-tab-inactive {
    @apply bg-white/70 text-gray-600 hover:bg-white border border-primary-100;
  }

  /* ── Glass Panel ── */
  .glass {
    @apply bg-white/60 backdrop-blur-md border border-white/70 rounded-2xl;
  }
}
