const express = require('express');
const db = require('../database/connection');
const { authenticate, authorize } = require('../middleware/auth');

const router = express.Router();

router.get('/', authenticate, async (req, res, next) => {
  try {
    const { search, page = 1, limit = 20 } = req.query;
    const offset = (page - 1) * limit;
    const params = [];
    let where = '';

    if (search) {
      params.push(`%${search}%`);
      where = `WHERE name ILIKE $${params.length} OR phone ILIKE $${params.length} OR member_code ILIKE $${params.length}`;
    }

    params.push(parseInt(limit), parseInt(offset));

    const result = await db.query(
      `SELECT * FROM customers ${where} ORDER BY name LIMIT $${params.length - 1} OFFSET $${params.length}`,
      params
    );

    res.json({ success: true, data: result.rows });
  } catch (err) {
    next(err);
  }
});

router.post('/', authenticate, async (req, res, next) => {
  try {
    const { name, phone, email } = req.body;
    const memberCode = `MBR-${Date.now()}`;

    const result = await db.query(
      'INSERT INTO customers (member_code, name, phone, email) VALUES ($1, $2, $3, $4) RETURNING *',
      [memberCode, name, phone, email]
    );

    res.status(201).json({ success: true, data: result.rows[0] });
  } catch (err) {
    next(err);
  }
});

router.get('/:id', authenticate, async (req, res, next) => {
  try {
    const result = await db.query('SELECT * FROM customers WHERE id = $1', [req.params.id]);

    if (result.rows.length === 0) {
      return res.status(404).json({ success: false, error: { message: 'ไม่พบลูกค้า' } });
    }

    // ดึงประวัติการซื้อ
    const orders = await db.query(
      `SELECT id, order_no, total_amount, payment_method, created_at
       FROM orders WHERE customer_id = $1 AND status = 'completed'
       ORDER BY created_at DESC LIMIT 20`,
      [req.params.id]
    );

    res.json({
      success: true,
      data: { ...result.rows[0], purchase_history: orders.rows },
    });
  } catch (err) {
    next(err);
  }
});

router.put('/:id', authenticate, async (req, res, next) => {
  try {
    const { name, phone, email } = req.body;
    const result = await db.query(
      'UPDATE customers SET name=$1, phone=$2, email=$3, updated_at=NOW() WHERE id=$4 RETURNING *',
      [name, phone, email, req.params.id]
    );

    res.json({ success: true, data: result.rows[0] });
  } catch (err) {
    next(err);
  }
});

module.exports = router;
