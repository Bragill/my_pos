const express = require('express');
const db = require('../database/connection');
const { authenticate, authorize } = require('../middleware/auth');

const router = express.Router();

// ยอดขายรายวัน
router.get('/daily-sales', authenticate, authorize('admin', 'manager'), async (req, res, next) => {
  try {
    const { days = 30 } = req.query;
    const result = await db.query(
      `SELECT DATE(created_at) as date,
              COUNT(*) as total_orders,
              SUM(total_amount) as total_sales,
              SUM(discount) as total_discount,
              SUM(tax) as total_tax
       FROM orders
       WHERE status = 'completed' AND created_at >= NOW() - INTERVAL '${parseInt(days)} days'
       GROUP BY DATE(created_at)
       ORDER BY date DESC`
    );

    res.json({ success: true, data: result.rows });
  } catch (err) {
    next(err);
  }
});

// สินค้าขายดี
router.get('/top-products', authenticate, authorize('admin', 'manager'), async (req, res, next) => {
  try {
    const { limit = 10, days = 30 } = req.query;

    const result = await db.query(
      `SELECT p.id, p.name, p.sku, SUM(oi.quantity) as total_quantity,
              SUM(oi.total_price) as total_revenue
       FROM order_items oi
       JOIN products p ON oi.product_id = p.id
       JOIN orders o ON oi.order_id = o.id
       WHERE o.status = 'completed' AND o.created_at >= NOW() - INTERVAL '${parseInt(days)} days'
       GROUP BY p.id, p.name, p.sku
       ORDER BY total_quantity DESC
       LIMIT $1`,
      [parseInt(limit)]
    );

    res.json({ success: true, data: result.rows });
  } catch (err) {
    next(err);
  }
});

// ประสิทธิภาพแคชเชียร์
router.get('/cashier-performance', authenticate, authorize('admin', 'manager'), async (req, res, next) => {
  try {
    const { days = 30 } = req.query;

    const result = await db.query(
      `SELECT u.id, u.full_name,
              COUNT(o.id) as total_orders,
              SUM(o.total_amount) as total_sales,
              AVG(o.total_amount) as avg_order_value
       FROM orders o
       JOIN users u ON o.user_id = u.id
       WHERE o.status = 'completed' AND o.created_at >= NOW() - INTERVAL '${parseInt(days)} days'
       GROUP BY u.id, u.full_name
       ORDER BY total_sales DESC`
    );

    res.json({ success: true, data: result.rows });
  } catch (err) {
    next(err);
  }
});

// มูลค่าสต๊อกคงเหลือ
router.get('/stock-value', authenticate, authorize('admin', 'manager'), async (req, res, next) => {
  try {
    const result = await db.query(
      `SELECT p.id, p.name, p.sku, p.cost_price, p.selling_price,
              i.quantity,
              (p.cost_price * i.quantity) as stock_cost_value,
              (p.selling_price * i.quantity) as stock_retail_value
       FROM inventory i
       JOIN products p ON i.product_id = p.id
       WHERE p.is_active = true AND i.quantity > 0
       ORDER BY stock_cost_value DESC`
    );

    const totalCost = result.rows.reduce((sum, r) => sum + parseFloat(r.stock_cost_value), 0);
    const totalRetail = result.rows.reduce((sum, r) => sum + parseFloat(r.stock_retail_value), 0);

    res.json({
      success: true,
      data: {
        items: result.rows,
        summary: { total_cost_value: totalCost, total_retail_value: totalRetail },
      },
    });
  } catch (err) {
    next(err);
  }
});

// แดชบอร์ดสรุป
router.get('/dashboard', authenticate, async (req, res, next) => {
  try {
    const today = await db.query(
      `SELECT COUNT(*) as orders, COALESCE(SUM(total_amount), 0) as sales
       FROM orders WHERE status = 'completed' AND DATE(created_at) = CURRENT_DATE`
    );

    const lowStock = await db.query(
      `SELECT COUNT(*) as count FROM inventory i
       JOIN products p ON i.product_id = p.id
       WHERE i.quantity <= i.reorder_level AND p.is_active = true`
    );

    const monthSales = await db.query(
      `SELECT COALESCE(SUM(total_amount), 0) as sales
       FROM orders WHERE status = 'completed'
       AND DATE_TRUNC('month', created_at) = DATE_TRUNC('month', CURRENT_DATE)`
    );

    res.json({
      success: true,
      data: {
        today_orders: parseInt(today.rows[0].orders),
        today_sales: parseFloat(today.rows[0].sales),
        month_sales: parseFloat(monthSales.rows[0].sales),
        low_stock_count: parseInt(lowStock.rows[0].count),
      },
    });
  } catch (err) {
    next(err);
  }
});

module.exports = router;
