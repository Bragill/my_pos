const express = require('express');
const db = require('../database/connection');
const { authenticate } = require('../middleware/auth');
const { AppError } = require('../middleware/errorHandler');

const router = express.Router();

// เปิดกะ
router.post('/open', authenticate, async (req, res, next) => {
  try {
    const { opening_amount = 0 } = req.body;

    // ตรวจสอบว่ามีกะที่เปิดอยู่
    const existing = await db.query(
      "SELECT id FROM shifts WHERE user_id = $1 AND status = 'open'",
      [req.user.id]
    );

    if (existing.rows.length > 0) {
      return next(new AppError('คุณมีกะที่เปิดอยู่แล้ว กรุณาปิดกะก่อน', 400));
    }

    const result = await db.query(
      'INSERT INTO shifts (user_id, opening_amount) VALUES ($1, $2) RETURNING *',
      [req.user.id, opening_amount]
    );

    res.status(201).json({ success: true, data: result.rows[0] });
  } catch (err) {
    next(err);
  }
});

// ปิดกะ
router.post('/close', authenticate, async (req, res, next) => {
  try {
    const { closing_amount } = req.body;

    const shift = await db.query(
      "SELECT * FROM shifts WHERE user_id = $1 AND status = 'open'",
      [req.user.id]
    );

    if (shift.rows.length === 0) {
      return next(new AppError('ไม่พบกะที่เปิดอยู่', 404));
    }

    const shiftData = shift.rows[0];

    // คำนวณยอดที่ควรจะได้
    const salesResult = await db.query(
      `SELECT COALESCE(SUM(total_amount), 0) as total
       FROM orders
       WHERE user_id = $1 AND status = 'completed' AND payment_method = 'cash'
       AND created_at >= $2`,
      [req.user.id, shiftData.opened_at]
    );

    const expectedAmount = parseFloat(shiftData.opening_amount) + parseFloat(salesResult.rows[0].total);
    const difference = closing_amount - expectedAmount;

    const result = await db.query(
      `UPDATE shifts SET closing_amount=$1, expected_amount=$2, difference=$3,
       status='closed', closed_at=NOW()
       WHERE id=$4 RETURNING *`,
      [closing_amount, expectedAmount, difference, shiftData.id]
    );

    res.json({ success: true, data: result.rows[0] });
  } catch (err) {
    next(err);
  }
});

// ดึงกะปัจจุบัน
router.get('/current', authenticate, async (req, res, next) => {
  try {
    const result = await db.query(
      "SELECT * FROM shifts WHERE user_id = $1 AND status = 'open'",
      [req.user.id]
    );

    res.json({ success: true, data: result.rows[0] || null });
  } catch (err) {
    next(err);
  }
});

module.exports = router;
