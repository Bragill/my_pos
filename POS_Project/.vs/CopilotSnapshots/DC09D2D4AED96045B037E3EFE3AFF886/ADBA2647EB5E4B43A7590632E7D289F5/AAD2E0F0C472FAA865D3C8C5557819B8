const express = require('express');
const db = require('../database/connection');
const { authenticate, authorize } = require('../middleware/auth');

const router = express.Router();

router.get('/', authenticate, async (req, res, next) => {
  try {
    const result = await db.query('SELECT * FROM store_settings LIMIT 1');
    res.json({ success: true, data: result.rows[0] || {} });
  } catch (err) {
    next(err);
  }
});

router.put('/', authenticate, authorize('admin'), async (req, res, next) => {
  try {
    const { store_name, address, phone, tax_id, vat_rate, receipt_header, receipt_footer, logo_url } = req.body;

    const result = await db.query(
      `UPDATE store_settings
       SET store_name=$1, address=$2, phone=$3, tax_id=$4, vat_rate=$5,
           receipt_header=$6, receipt_footer=$7, logo_url=$8, updated_at=NOW()
       RETURNING *`,
      [store_name, address, phone, tax_id, vat_rate, receipt_header, receipt_footer, logo_url]
    );

    res.json({ success: true, data: result.rows[0] });
  } catch (err) {
    next(err);
  }
});

module.exports = router;
