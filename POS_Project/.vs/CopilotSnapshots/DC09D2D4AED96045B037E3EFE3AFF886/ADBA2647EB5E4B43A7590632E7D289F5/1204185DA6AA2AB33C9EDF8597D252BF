const express = require('express');
const db = require('../database/connection');
const { authenticate, authorize } = require('../middleware/auth');
const { AppError } = require('../middleware/errorHandler');

const router = express.Router();

// สร้างออเดอร์ใหม่ (ชำระเงิน) - ใช้ ACID Transaction
router.post('/', authenticate, async (req, res, next) => {
  const client = await db.pool.connect();
  try {
    const { items, customer_id, payment_method, discount = 0, remark } = req.body;
    const vatRate = parseFloat(process.env.VAT_RATE || 7) / 100;

    await client.query('BEGIN');

    // คำนวณยอดรวม
    let subTotal = 0;
    const orderItems = [];

    for (const item of items) {
      const productResult = await client.query(
        'SELECT id, selling_price, name FROM products WHERE id = $1 AND is_active = true',
        [item.product_id]
      );

      if (productResult.rows.length === 0) {
        throw new AppError(`ไม่พบสินค้า: ${item.product_id}`, 400);
      }

      const product = productResult.rows[0];
      const unitPrice = item.unit_price || product.selling_price;
      const itemDiscount = item.discount || 0;
      const totalPrice = (unitPrice * item.quantity) - itemDiscount;

      orderItems.push({
        product_id: product.id,
        quantity: item.quantity,
        unit_price: unitPrice,
        discount: itemDiscount,
        total_price: totalPrice,
      });

      subTotal += totalPrice;
    }

    const taxableAmount = subTotal - discount;
    const tax = Math.round(taxableAmount * vatRate * 100) / 100;
    const totalAmount = taxableAmount + tax;

    // สร้างเลขที่บิล
    const orderNo = `POS-${Date.now()}`;

    // บันทึก order
    const orderResult = await client.query(
      `INSERT INTO orders (order_no, user_id, customer_id, sub_total, discount, tax, total_amount, payment_method, status, remark)
       VALUES ($1, $2, $3, $4, $5, $6, $7, $8, 'completed', $9) RETURNING *`,
      [orderNo, req.user.id, customer_id, subTotal, discount, tax, totalAmount, payment_method, remark]
    );

    const order = orderResult.rows[0];

    // บันทึก order items & ตัดสต๊อก
    for (const item of orderItems) {
      await client.query(
        `INSERT INTO order_items (order_id, product_id, quantity, unit_price, discount, total_price)
         VALUES ($1, $2, $3, $4, $5, $6)`,
        [order.id, item.product_id, item.quantity, item.unit_price, item.discount, item.total_price]
      );

      // ตัดสต๊อก
      await client.query(
        'UPDATE inventory SET quantity = quantity - $1, updated_at = NOW() WHERE product_id = $2',
        [item.quantity, item.product_id]
      );

      // บันทึกประวัติสต๊อก
      await client.query(
        `INSERT INTO stock_transactions (product_id, user_id, type, quantity, remark)
         VALUES ($1, $2, 'sale', $3, $4)`,
        [item.product_id, req.user.id, -item.quantity, `ขาย - บิล ${orderNo}`]
      );
    }

    // บันทึกการชำระเงิน
    await client.query(
      'INSERT INTO payments (order_id, payment_type, amount) VALUES ($1, $2, $3)',
      [order.id, payment_method, totalAmount]
    );

    // สะสมแต้มสมาชิก (1 แต้มต่อ 100 บาท)
    if (customer_id) {
      const pointsEarned = Math.floor(totalAmount / 100);
      if (pointsEarned > 0) {
        await client.query(
          'UPDATE customers SET points = points + $1, updated_at = NOW() WHERE id = $2',
          [pointsEarned, customer_id]
        );
      }
    }

    await client.query('COMMIT');

    // ดึงข้อมูลออเดอร์พร้อมรายการ
    const fullOrder = await db.query(
      `SELECT o.*, json_agg(json_build_object(
        'product_id', oi.product_id,
        'quantity', oi.quantity,
        'unit_price', oi.unit_price,
        'discount', oi.discount,
        'total_price', oi.total_price
       )) as items
       FROM orders o
       JOIN order_items oi ON o.id = oi.order_id
       WHERE o.id = $1
       GROUP BY o.id`,
      [order.id]
    );

    res.status(201).json({ success: true, data: fullOrder.rows[0] });
  } catch (err) {
    await client.query('ROLLBACK');
    next(err);
  } finally {
    client.release();
  }
});

// พักบิล
router.post('/:id/park', authenticate, async (req, res, next) => {
  try {
    const result = await db.query(
      "UPDATE orders SET status = 'parked', updated_at = NOW() WHERE id = $1 AND status = 'pending' RETURNING *",
      [req.params.id]
    );

    if (result.rows.length === 0) {
      return next(new AppError('ไม่พบบิลหรือสถานะไม่ถูกต้อง', 404));
    }

    res.json({ success: true, data: result.rows[0] });
  } catch (err) {
    next(err);
  }
});

// ดึงบิลที่พักไว้
router.get('/parked', authenticate, async (req, res, next) => {
  try {
    const result = await db.query(
      `SELECT o.*, json_agg(json_build_object(
        'product_id', oi.product_id,
        'quantity', oi.quantity,
        'unit_price', oi.unit_price,
        'total_price', oi.total_price
       )) as items
       FROM orders o
       JOIN order_items oi ON o.id = oi.order_id
       WHERE o.status = 'parked' AND o.user_id = $1
       GROUP BY o.id
       ORDER BY o.created_at DESC`,
      [req.user.id]
    );

    res.json({ success: true, data: result.rows });
  } catch (err) {
    next(err);
  }
});

// คืนเงิน (Refund)
router.post('/:id/refund', authenticate, authorize('admin', 'manager'), async (req, res, next) => {
  const client = await db.pool.connect();
  try {
    await client.query('BEGIN');

    const orderResult = await client.query(
      "SELECT * FROM orders WHERE id = $1 AND status = 'completed'",
      [req.params.id]
    );

    if (orderResult.rows.length === 0) {
      throw new AppError('ไม่พบบิลหรือสถานะไม่ถูกต้อง', 404);
    }

    // คืนสต๊อก
    const itemsResult = await client.query(
      'SELECT * FROM order_items WHERE order_id = $1',
      [req.params.id]
    );

    for (const item of itemsResult.rows) {
      await client.query(
        'UPDATE inventory SET quantity = quantity + $1, updated_at = NOW() WHERE product_id = $2',
        [item.quantity, item.product_id]
      );

      await client.query(
        `INSERT INTO stock_transactions (product_id, user_id, type, quantity, remark)
         VALUES ($1, $2, 'return', $3, $4)`,
        [item.product_id, req.user.id, item.quantity, `คืนเงิน - บิล ${orderResult.rows[0].order_no}`]
      );
    }

    await client.query(
      "UPDATE orders SET status = 'refunded', updated_at = NOW() WHERE id = $1",
      [req.params.id]
    );

    await client.query('COMMIT');
    res.json({ success: true, message: 'คืนเงินสำเร็จ' });
  } catch (err) {
    await client.query('ROLLBACK');
    next(err);
  } finally {
    client.release();
  }
});

// ดึงรายการออเดอร์
router.get('/', authenticate, async (req, res, next) => {
  try {
    const { status, date_from, date_to, page = 1, limit = 20 } = req.query;
    const offset = (page - 1) * limit;
    const params = [];
    let where = 'WHERE 1=1';

    if (status) {
      params.push(status);
      where += ` AND o.status = $${params.length}`;
    }
    if (date_from) {
      params.push(date_from);
      where += ` AND o.created_at >= $${params.length}`;
    }
    if (date_to) {
      params.push(date_to);
      where += ` AND o.created_at <= $${params.length}`;
    }

    params.push(parseInt(limit), parseInt(offset));

    const result = await db.query(
      `SELECT o.*, u.full_name as cashier_name, c.name as customer_name
       FROM orders o
       LEFT JOIN users u ON o.user_id = u.id
       LEFT JOIN customers c ON o.customer_id = c.id
       ${where}
       ORDER BY o.created_at DESC
       LIMIT $${params.length - 1} OFFSET $${params.length}`,
      params
    );

    res.json({ success: true, data: result.rows });
  } catch (err) {
    next(err);
  }
});

module.exports = router;
