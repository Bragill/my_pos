@tailwind base;
@tailwind components;
@tailwind utilities;

body {
  font-family: 'Prompt', 'Noto Sans Thai', sans-serif;
}

@layer components {
  .btn-primary {
    @apply bg-primary-600 hover:bg-primary-700 text-white font-medium py-3 px-6 rounded-lg
           transition-colors min-h-touch min-w-touch flex items-center justify-center;
  }

  .btn-success {
    @apply bg-success-600 hover:bg-green-700 text-white font-bold py-4 px-8 rounded-xl
           transition-colors min-h-touch text-lg;
  }

  .btn-danger {
    @apply bg-danger-600 hover:bg-red-700 text-white font-medium py-3 px-6 rounded-lg
           transition-colors min-h-touch min-w-touch;
  }

  .btn-ghost {
    @apply bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-3 px-4 rounded-lg
           transition-colors min-h-touch min-w-touch;
  }

  .card {
    @apply bg-white rounded-xl shadow-sm border border-gray-100 p-4;
  }

  .input-field {
    @apply w-full border border-gray-300 rounded-lg px-4 py-3 text-base
           focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent;
  }

  .product-grid-item {
    @apply bg-white rounded-xl border border-gray-200 p-3 cursor-pointer
           hover:border-primary-500 hover:shadow-md transition-all
           flex flex-col items-center justify-center min-h-[100px]
           active:scale-95;
  }

  .category-tab {
    @apply px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap
           min-h-touch flex items-center justify-center cursor-pointer
           transition-colors;
  }

  .category-tab-active {
    @apply bg-primary-600 text-white;
  }

  .category-tab-inactive {
    @apply bg-gray-100 text-gray-600 hover:bg-gray-200;
  }
}
