import { Outlet, NavLink, useNavigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';

const navItems = [
  { path: '/pos', label: 'หน้าขาย', icon: '🛒', roles: ['admin', 'manager', 'cashier'] },
  { path: '/dashboard', label: 'แดชบอร์ด', icon: '📊', roles: ['admin', 'manager'] },
  { path: '/products', label: 'สินค้า', icon: '📦', roles: ['admin', 'manager'] },
  { path: '/inventory', label: 'สต๊อก', icon: '🏪', roles: ['admin', 'manager'] },
  { path: '/customers', label: 'ลูกค้า', icon: '👥', roles: ['admin', 'manager', 'cashier'] },
  { path: '/settings', label: 'ตั้งค่า', icon: '⚙️', roles: ['admin'] },
];

export default function Layout() {
  const { user, logout } = useAuth();
  const navigate = useNavigate();

  const handleLogout = () => {
    logout();
    navigate('/login');
  };

  const visibleNav = navItems.filter((item) => item.roles.includes(user?.role));

  return (
    <div className="min-h-screen flex flex-col">
      {/* Top Navigation */}
      <nav className="bg-white border-b border-gray-200 px-2 py-2 flex items-center justify-between">
        <div className="flex items-center gap-1 overflow-x-auto flex-1">
          {visibleNav.map((item) => (
            <NavLink
              key={item.path}
              to={item.path}
              className={({ isActive }) =>
                `flex flex-col sm:flex-row items-center justify-center px-2 sm:px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium transition-colors whitespace-nowrap min-w-[44px] ${isActive ? 'bg-blue-100 text-blue-700' : 'text-gray-600 hover:bg-gray-100'}`
              }
            >
              <span className="text-lg sm:text-base sm:mr-1">{item.icon}</span>
              <span className="hidden sm:inline">{item.label}</span>
            </NavLink>
          ))}
        </div>

        <div className="flex items-center gap-2 ml-2 flex-shrink-0">
          <span className="text-xs text-gray-500 hidden lg:inline">
            {user?.fullName}
          </span>
          <button onClick={handleLogout} className="text-xs text-gray-600 bg-gray-100 hover:bg-gray-200 active:bg-gray-300 px-2 py-1.5 rounded-lg transition-colors whitespace-nowrap">
            ออกจากระบบ
          </button>
        </div>
      </nav>

      {/* Main Content */}
      <main className="flex-1 overflow-hidden">
        <Outlet />
      </main>
    </div>
  );
}
