import { createContext, useContext, useState, useEffect } from 'react';
import api from '../services/api';

const AuthContext = createContext(null);

const syncVatRate = async () => {
  try {
    const res = await api.get('/settings');
    const rate = res.data.data?.vat_rate ?? 7;
    localStorage.setItem('vat_rate', String(rate));
  } catch {}
};

export function AuthProvider({ children }) {
  const [user, setUser] = useState(() => {
    const saved = localStorage.getItem('pos_user');
    return saved ? JSON.parse(saved) : null;
  });

  // Sync VAT on app start if user already logged in
  useEffect(() => { if (user) syncVatRate(); }, []);

  const login = async (username, password) => {
    const res = await api.post('/auth/login', { username, password });
    const { token, user: userData } = res.data.data;
    localStorage.setItem('pos_token', token);
    localStorage.setItem('pos_user', JSON.stringify(userData));
    setUser(userData);
    await syncVatRate(); // always get fresh VAT after login
    return userData;
  };

  const pinLogin = async (pin) => {
    const res = await api.post('/auth/pin-login', { pin });
    const { token, user: userData } = res.data.data;
    localStorage.setItem('pos_token', token);
    localStorage.setItem('pos_user', JSON.stringify(userData));
    setUser(userData);
    await syncVatRate();
    return userData;
  };

  const logout = () => {
    localStorage.removeItem('pos_token');
    localStorage.removeItem('pos_user');
    setUser(null);
  };

  return (
    <AuthContext.Provider value={{ user, login, pinLogin, logout }}>
      {children}
    </AuthContext.Provider>
  );
}

export const useAuth = () => useContext(AuthContext);
