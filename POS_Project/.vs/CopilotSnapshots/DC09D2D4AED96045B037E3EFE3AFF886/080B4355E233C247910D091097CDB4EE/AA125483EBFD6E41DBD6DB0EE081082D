const express = require("express");
const bcrypt = require("bcryptjs");
const db = require("../database/dbHelper");
const { authenticate, authorize } = require("../middleware/auth");
const { AppError } = require("../middleware/errorHandler");
const { v4: uuidv4 } = require("uuid");
const router = express.Router();

// GET all users
router.get("/", authenticate, authorize("admin"), (req, res, next) => {
  try {
    const users = db.all("SELECT u.id, u.username, u.full_name, u.pin_code, u.status, r.name as role_name, u.created_at FROM users u JOIN roles r ON u.role_id = r.id ORDER BY u.created_at DESC");
    res.json({ success: true, data: users });
  } catch (err) { next(err); }
});

// GET all roles
router.get("/roles", authenticate, authorize("admin"), (req, res, next) => {
  try {
    const roles = db.all("SELECT id, name FROM roles ORDER BY name");
    res.json({ success: true, data: roles });
  } catch (err) { next(err); }
});

// CREATE user
router.post("/", authenticate, authorize("admin"), (req, res, next) => {
  try {
    const { username, password, pin_code, full_name, role_id } = req.body;
    if (!username || !password || !full_name || !role_id) return next(new AppError("กรุณากรอกข้อมูลให้ครบถ้วน", 400));
    const existing = db.get("SELECT id FROM users WHERE username = ?", [username]);
    if (existing) return next(new AppError("ชื่อผู้ใช้นี้มีอยู่แล้ว", 400));
    const id = uuidv4();
    const hash = bcrypt.hashSync(password, 12);
    db.run("INSERT INTO users (id, username, password_hash, pin_code, full_name, role_id) VALUES (?,?,?,?,?,?)", [id, username, hash, pin_code || null, full_name, role_id]);
    const user = db.get("SELECT u.id, u.username, u.full_name, u.pin_code, u.status, r.name as role_name, u.created_at FROM users u JOIN roles r ON u.role_id = r.id WHERE u.id = ?", [id]);
    res.status(201).json({ success: true, data: user });
  } catch (err) { next(err); }
});

// UPDATE user
router.put("/:id", authenticate, authorize("admin"), (req, res, next) => {
  try {
    const { full_name, pin_code, role_id, status, password } = req.body;
    const user = db.get("SELECT id FROM users WHERE id = ?", [req.params.id]);
    if (!user) return next(new AppError("ไม่พบผู้ใช้งาน", 404));
    if (password) {
      const hash = bcrypt.hashSync(password, 12);
      db.run("UPDATE users SET full_name=?, pin_code=?, role_id=?, status=?, password_hash=?, updated_at=datetime('now') WHERE id=?", [full_name, pin_code || null, role_id, status, hash, req.params.id]);
    } else {
      db.run("UPDATE users SET full_name=?, pin_code=?, role_id=?, status=?, updated_at=datetime('now') WHERE id=?", [full_name, pin_code || null, role_id, status, req.params.id]);
    }
    const updated = db.get("SELECT u.id, u.username, u.full_name, u.pin_code, u.status, r.name as role_name, u.created_at FROM users u JOIN roles r ON u.role_id = r.id WHERE u.id = ?", [req.params.id]);
    res.json({ success: true, data: updated });
  } catch (err) { next(err); }
});

// DELETE user
router.delete("/:id", authenticate, authorize("admin"), (req, res, next) => {
  try {
    if (req.user.id === req.params.id) return next(new AppError("ไม่สามารถลบบัญชีตัวเองได้", 400));
    const user = db.get("SELECT id FROM users WHERE id = ?", [req.params.id]);
    if (!user) return next(new AppError("ไม่พบผู้ใช้งาน", 404));
    db.run("DELETE FROM users WHERE id = ?", [req.params.id]);
    res.json({ success: true, message: "ลบผู้ใช้งานสำเร็จ" });
  } catch (err) { next(err); }
});

module.exports = router;
