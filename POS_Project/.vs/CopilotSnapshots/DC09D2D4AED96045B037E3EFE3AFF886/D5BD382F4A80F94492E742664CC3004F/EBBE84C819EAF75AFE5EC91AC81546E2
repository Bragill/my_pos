const express = require("express");
const db = require("../database/dbHelper");
const { authenticate, authorize } = require("../middleware/auth");
const { v4: uuidv4 } = require("uuid");
const router = express.Router();

router.get("/", authenticate, (req, res, next) => {
  try {
    const { low_stock } = req.query;
    let q = "SELECT p.id,p.sku,p.barcode,p.name,p.cost_price,p.selling_price,i.quantity,i.reorder_level,c.name as category_name FROM inventory i JOIN products p ON i.product_id=p.id LEFT JOIN categories c ON p.category_id=c.id WHERE p.is_active=1";
    if (low_stock === "true") q += " AND i.quantity<=i.reorder_level";
    q += " ORDER BY p.name";
    res.json({ success: true, data: db.all(q) });
  } catch(e) { next(e); }
});
router.post("/receive", authenticate, authorize("admin","manager"), (req, res, next) => {
  try {
    const { product_id, quantity, remark } = req.body;
    db.run("UPDATE inventory SET quantity=quantity+?,updated_at=datetime('now') WHERE product_id=?", [quantity, product_id]);
    db.run("INSERT INTO stock_transactions (id,product_id,user_id,type,quantity,remark) VALUES (?,?,?,'receive',?,?)", [uuidv4(), product_id, req.user.id, quantity, remark||null]);
    res.json({ success: true, message: "Stock received" });
  } catch(e) { next(e); }
});
router.post("/issue", authenticate, authorize("admin","manager"), (req, res, next) => {
  try {
    const { product_id, quantity, remark } = req.body;
    db.run("UPDATE inventory SET quantity=quantity-?,updated_at=datetime('now') WHERE product_id=?", [quantity, product_id]);
    db.run("INSERT INTO stock_transactions (id,product_id,user_id,type,quantity,remark) VALUES (?,?,?,'issue',?,?)", [uuidv4(), product_id, req.user.id, -quantity, remark||null]);
    res.json({ success: true, message: "Stock issued" });
  } catch(e) { next(e); }
});
router.post("/adjust", authenticate, authorize("admin","manager"), (req, res, next) => {
  try {
    const { product_id, new_quantity, remark } = req.body;
    const cur = db.get("SELECT quantity FROM inventory WHERE product_id=?", [product_id]);
    const diff = new_quantity - (cur ? cur.quantity : 0);
    db.run("UPDATE inventory SET quantity=?,updated_at=datetime('now') WHERE product_id=?", [new_quantity, product_id]);
    db.run("INSERT INTO stock_transactions (id,product_id,user_id,type,quantity,remark) VALUES (?,?,?,'adjust',?,?)", [uuidv4(), product_id, req.user.id, diff, remark||"Adjust"]);
    res.json({ success: true, message: "Stock adjusted" });
  } catch(e) { next(e); }
});
module.exports = router;
